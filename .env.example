# LM Studio URL (default: http://localhost:1234)
LM_STUDIO_URL=http://localhost:1234

# Model name (must match the model loaded in LM Studio)
# Default: bielik-11b-v3.0-mlx (32K context, good for summarize + reconstruct)
LM_STUDIO_MODEL=bielik-11b-v3.0-mlx

# Server port (default: 4000)
PORT=4000

# Cache TTL in minutes (default: 60)
CACHE_TTL_MINUTES=60
