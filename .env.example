# ytTranscript — Environment Configuration
# Copy to .env and edit as needed. .env is gitignored.

# ─── LLM Provider (env-driven) ────────────────────────────────────
# Supported values:
#   "omlx"       — local oMLX server (default, backwards-compatible)
#   "freellmapi" — FreeLLMAPI proxy (auto-selects best free provider)
#   "mistral"    — Mistral API (paid, requires API key from console.mistral.ai)
#   "groq"       — Groq API (free tier, requires API key from console.groq.com)
# Switch without touching server.js — just change LLM_PROVIDER and restart.
LLM_PROVIDER=omlx

# ─── Fallback chain (optional, OFF by default!) ──────────────────
# Comma-separated provider names tried in order when the primary's health
# check fails. Empty/unset = no fallback (single-provider mode).
# WARNING: default was 'omlx' (unstable local server). Changed to ''.
# Fallback must be an explicitly configured production API provider.
# Example: LLM_PROVIDER_FALLBACK=groq
# Notes:
#   - Skip the primary name (it is always tried first).
#   - Unknown names are logged and skipped at startup.
#   - The active provider is sticky until its health check fails.
LLM_PROVIDER_FALLBACK=omlx

# ─── Health cache TTL (ms) ────────────────────────────────────────
# How long /api/lm-status and /api/transform cache the LLM health result.
# Prevents flakiness when large models cold-start on each probe call.
HEALTH_CACHE_TTL_MS=3000

# ─── oMLX provider (used when LLM_PROVIDER=omlx) ─────────────────
# oMLX is a local OpenAI-compatible server. The previous default was
# LM Studio + Bielik; the codebase now targets oMLX + gemma-4-12b.
OMLX_URL=http://127.0.0.1:8585
OMLX_MODEL=gemma-4-12b-it-nvfp4
# Optional — oMLX may run without auth. Leave empty unless you enabled a key.
OMLX_API_KEY=

# ─── FreeLLMAPI provider (used when LLM_PROVIDER=freellmapi) ─────
# FreeLLMAPI is a local proxy server that auto-selects the best free LLM.
# Dashboard and endpoint: http://127.0.0.1:3001/
FREELLMAPI_URL=http://127.0.0.1:3001
FREELLMAPI_API_KEY=freellmapi-745a48317f4c96e7f2da0f1c59fd1757905a3e8eb5815134
# "auto" = FreeLLMAPI rotates to the currently best free provider.
FREELLMAPI_MODEL=auto

# ─── Mistral provider (used when LLM_PROVIDER=mistral) ────────────
# Direct Mistral API. Requires paid account or trial credits.
# Get a key: https://console.mistral.ai/api/keys
MISTRAL_URL=https://api.mistral.ai/v1
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-2603

# ─── Groq provider (used when LLM_PROVIDER=groq) ─────────────────
# Direct Groq API. Free tier available with rate limits.
# Get a key: https://console.groq.com/keys
GROQ_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Legacy aliases kept for backwards compatibility:
# LM_STUDIO_URL, LM_STUDIO_MODEL, LM_STUDIO_API_KEY
# (server.js falls back to OMLX_* when these are unset, and vice versa)

# ─── Server ─────────────────────────────────────────────────────
PORT=4000

# ─── Cache ──────────────────────────────────────────────────────
CACHE_TTL_MINUTES=60

# ─── TTS (Piper, optional) ─────────────────────────────────────
# Piper is optional. When PIPER_BIN does not exist, /api/tts returns
# 503 with a clear message instead of crashing.
#
# macOS — after: pip3 install piper-tts
#   PIPER_BIN=/Users/radek/Library/Python/3.9/bin/piper
#
# Linux (Lenovo Server) — after: pip3 install piper-tts
#   PIPER_BIN=/usr/local/bin/piper
PIPER_BIN=/usr/local/bin/piper
PIPER_MODELS_DIR=/opt/yt-transcript/piper-models

# ─── Demo Limit ──────────────────────────────────────────────────
# When enabled, limits AI actions (reconstruct/summarize) to N per IP per day.
# One switch to enable/disable — no code changes needed.
# IMPORTANT: Set NODE_ENV=production when exposing publicly.
YTTRANSCRIPT_AI_DAILY_LIMIT_ENABLED=false
YTTRANSCRIPT_AI_DAILY_LIMIT=6

# ─── Portfolio Links ─────────────────────────────────────────────
# Used in the header, footer, and demo popup.
YTTRANSCRIPT_CONTACT_EMAIL=kontakt@radoslaw-pleskot.com
YTTRANSCRIPT_PROJECT_DESCRIPTION_URL=https://radoslaw-pleskot.com/portfolio/yttranscript
YTTRANSCRIPT_PRIVACY_POLICY_URL=https://radoslaw-pleskot.com/privacy
